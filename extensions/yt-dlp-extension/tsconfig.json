{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "moduleResolution": "node",
        "lib": ["ES2020"],
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "declaration": true,
        // "allowJs": true,
        "outDir": "./dist",
        "strict": true,
        // "checkJs": true
        "paths": {
            "undici-types": ["./node_modules/undici-types/index.d.ts"]
            // "tree-kill": ["./node_modules/tree-kill/index.d.ts"]
        }
    },
    "include": ["src/**/*"]
    // "include": ["*.js"] // Adjust the pattern to include your JS files
}
